# API Keys para AgentScout

# OpenAI API Key - Necesaria para el procesamiento de lenguaje natural
OPENAI_API_KEY=sk-your-openai-api-key-here

# Search API Key - Tavily (recomendado) o Serper para búsquedas web
# Opción 1: Tavily
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# Opción 2: Serper
# SERPER_API_KEY=your-serper-api-key-here

# Configuración del servidor
PORT=8000
HOST=0.0.0.0

# Configuración de la base de datos (opcional para futuras implementaciones)
# DATABASE_URL=postgresql://user:password@localhost:agentscout

# Configuración de Redis (opcional para cache)
# REDIS_URL=redis://localhost:6379

# Configuración de frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
